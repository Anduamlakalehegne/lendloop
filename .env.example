# Next.js / Clerk (publishable key is public; secret key is server-only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
# Run npx convex dev to populate CONVEX_DEPLOYMENT locally.
CONVEX_DEPLOYMENT=
# Set the following on Convex using npx convex env set, not just in this file:
CLERK_JWT_ISSUER_DOMAIN=
ADMIN_SUBJECTS=
N8N_REQUEST_WEBHOOK_URL=
AUTOMATION_SECRET=
# Docker n8n configuration (copy into .env for docker compose)
CONVEX_SITE_URL=
N8N_ENCRYPTION_KEY=
